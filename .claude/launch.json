{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "trading-service",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["run", "--project", "trading/src/Trading.Service"],
      "port": 5101
    },
    {
      "name": "trading-service-synthetic",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["run", "--project", "trading/src/Trading.Service", "--", "--PriceFeed:Provider=Synthetic"],
      "port": 5101
    },
    {
      "name": "trading-terminal",
      "runtimeExecutable": "node",
      "runtimeArgs": ["trading/terminal/node_modules/next/dist/bin/next", "dev", "trading/terminal", "--port", "3001"],
      "port": 3001
    },
    {
      "name": "trading-staff",
      "runtimeExecutable": "node",
      "runtimeArgs": ["trading/staff/node_modules/next/dist/bin/next", "dev", "trading/staff", "--port", "3003"],
      "port": 3003
    },
    {
      "name": "prop-api",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["run", "--project", "prop/src/Prop.Api"],
      "port": 5201
    },
    {
      "name": "prop-portal",
      "runtimeExecutable": "node",
      "runtimeArgs": ["prop/portal/node_modules/next/dist/bin/next", "dev", "prop/portal", "--port", "3002"],
      "port": 3002
    }
  ]
}
