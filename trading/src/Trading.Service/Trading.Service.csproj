<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- The OpenAPI document is generated on build and committed. The terminal generates its TypeScript types from it. -->
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)/../../terminal/openapi</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name trading-service</OpenApiGenerateDocumentsOptions>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Trading.Engine\Trading.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Trading.Service.Tests" />
  </ItemGroup>

</Project>
