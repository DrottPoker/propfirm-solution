<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- The OpenAPI document is the contract with the firms' systems and the prop platform. It is generated on build and committed. -->
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)/../../../contracts/trading</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name trading-service</OpenApiGenerateDocumentsOptions>
    <!-- Secrets for local development, such as the Tiingo API key, live outside the repository. -->
    <UserSecretsId>trading-service-6f0d4c2e-8a51-4c1f-9d3b-2f7e5a1c9b40</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Trading.Engine\Trading.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Persistence/Migrations/*.sql" LogicalName="Migrations/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Trading.Service.Tests" />
  </ItemGroup>

</Project>
