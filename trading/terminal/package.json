{
  "name": "@trading/terminal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start --port 3001",
    "lint": "eslint --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "generate:api": "openapi-typescript ../../contracts/trading/trading-service.json --empty-objects-unknown --output src/lib/api/schema.ts",
    "e2e": "node e2e/prepare-database.mjs && playwright test"
  },
  "dependencies": {
    "@kronant/design": "workspace:*",
    "@microsoft/signalr": "10.0.11",
    "@phosphor-icons/react": "2.1.10",
    "@tanstack/react-query": "5.104.0",
    "lightweight-charts": "5.2.1",
    "next": "16.3.8",
    "openapi-fetch": "0.17.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "2.0.8",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "5.0.3"
  }
}
