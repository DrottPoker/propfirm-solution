<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- The OpenAPI document is generated on build and committed. The portal generates its TypeScript types from it. -->
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)/../../portal/openapi</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name prop-api</OpenApiGenerateDocumentsOptions>
    <!-- Secrets for development, such as Didit's key, stay outside the repo. -->
    <UserSecretsId>prop-api-3b9e7c1a-5d24-4f86-a0c3-7e1b2d9f6a58</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MailKit" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\shared\src\Common.Postgres\Common.Postgres.csproj" />
    <ProjectReference Include="..\Prop.Rules\Prop.Rules.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Persistence/Migrations/*.sql" LogicalName="Migrations/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Prop.Api.Tests" />
  </ItemGroup>

</Project>
