  "components": {
    "schemas": {
      "AcceptInviteRequest": {
        "required": [
          "token",
          "password"
        ],
        "type": "object",
        "properties": {
          "token": {
            "type": [
              "null",
              "string"
            ]
          },
          "password": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "AccountDetailsResponse": {
        "required": [
          "account",
          "live",
          "breach"
        ],
        "type": "object",
        "properties": {
          "account": {
            "$ref": "#/components/schemas/AccountResponse"
          },
          "live": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/LiveFigures"
              }
            ]
          },
          "breach": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/BreachEvidence"
              }
            ]
          }
        },
        "description": "An account with its trading account right now, and the evidence if it failed."
      },
      "AccountResponse": {
        "required": [
          "id",
          "number",
          "email",
          "challengeId",
          "reference",
          "status",
          "stage",
          "stageName",
          "funded",
          "tradingAccountId",
          "tradingDays",
          "minTradingDays",
          "initialBalance",
          "currency",
          "profitTarget",
          "balance",
          "openPositions",
          "dailyFloor",
          "maxLossFloor",
          "createdAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "number": {
            "type": "integer",
            "format": "int64"
          },
          "email": {
            "type": "string"
          },
          "challengeId": {
            "type": "string"
          },
          "reference": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "$ref": "#/components/schemas/ChallengeStatus"
          },
          "stage": {
            "type": "integer",
            "format": "int32"
          },
          "stageName": {
            "type": "string"
          },
          "funded": {
            "type": "boolean"
          },
          "tradingAccountId": {
            "type": [
              "null",
              "string"
            ]
          },
          "tradingDays": {
            "type": "integer",
            "format": "int32"
          },
          "minTradingDays": {
            "type": "integer",
            "format": "int32"
          },
          "initialBalance": {
            "type": "number",
            "format": "double"
          },
          "currency": {
            "type": "string"
          },
          "profitTarget": {
            "type": [
              "null",
              "number"
            ],
            "format": "double"
          },
          "balance": {
            "type": [
              "null",
              "number"
            ],
            "format": "double"
          },
          "openPositions": {
            "type": "integer",
            "format": "int32"
          },
          "dailyFloor": {
            "type": [
              "null",
              "number"
            ],
            "format": "double"
          },
          "maxLossFloor": {
            "type": [
              "null",
              "number"
            ],
            "format": "double"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "description": "A trader's challenge account. TradingAccountId is the account on the trading platform\nfor the current stage, which starts at InitialBalance. The figures are what the trading\nplatform last reported."
      },
      "Branding": {
        "required": [
          "name",
          "logoUrl",
          "colors"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "logoUrl": {
            "type": [
              "null",
              "string"
            ]
          },
          "colors": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "description": "What the portal needs to look like the firm's own."
      },
      "BreachEvidence": {
        "required": [
          "time",
          "floorId",
          "level",
          "equity",
          "reason"
        ],
        "type": "object",
        "properties": {
          "time": {
            "type": "string",
            "format": "date-time"
          },
          "floorId": {
            "type": "string"
          },
          "level": {
            "type": "number",
            "format": "double"
          },
          "equity": {
            "type": "number",
            "format": "double"
          },
          "reason": {
            "$ref": "#/components/schemas/FailureReason"
          }
        },
        "description": "What the trading platform recorded when a floor was breached."
      },
      "CancelAccountRequest": {
        "required": [
          "reason"
        ],
        "type": "object",
        "properties": {
          "reason": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ChallengeDefinition": {
        "required": [
          "id",
          "name",
          "currency",
          "initialBalance",
          "tradingDay",
          "evaluation",
          "funded"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "initialBalance": {
            "type": "number",
            "format": "double"
          },
          "tradingDay": {
            "$ref": "#/components/schemas/TradingDayDefinition"
          },
          "evaluation": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StageRules"
            }
          },
          "funded": {
            "$ref": "#/components/schemas/StageRules"
          },
          "fundedStage": {
            "type": "integer",
            "description": "The index of the funded stage, after the evaluation stages.",
            "format": "int32"
          }
        },
        "description": "A challenge a firm sells: the account size, the trading day and the rules of each stage. Traders go\nthrough the evaluation stages in order and then trade a funded account. Every challenge keeps the\ndefinition it was bought with, so later changes by the firm never affect it."
      },
      "ChallengeStatus": {
        "enum": [
          "OpeningAccount",
          "Active",
          "AwaitingFunding",
          "Failed",
          "Cancelled"
        ]
      },
      "DailyLossReference": {
        "enum": [
          "Balance",
          "HigherOfBalanceAndEquity"
        ],
